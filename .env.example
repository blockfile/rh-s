# Copy to .env and fill in. Nothing broadcasts while DRY_RUN is true.

RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# The wallet that holds WETH and does the buying. Use one funded for this and
# nothing else — it is a hot key sitting on a server.
PRIVATE_KEY=

# What to bid per launch. The bot this models spends exactly 0.004, every time,
# and never scales to the pool.
BUY_ETH=0.004

# Skip any launch whose atomic dev buy is at or above this. Calibrated for a
# SMALL ticket: at 0.004 ETH a bid, pools past ~1 ETH of dev buy do not clear
# their own gas. RAISE THIS IF YOU RAISE BUY_ETH — larger operators on this
# chain bid ~0.07 ETH and profitably take launches this would skip.
MAX_DEV_BUY_ETH=1.0

# Floor on tokens received, as a haircut off the modelled output, in bps.
# 1500 = accept down to 85% of expected. This is the profitability guard, not
# ordinary slippage: it makes a buy REVERT when someone landed first and moved
# the price, instead of filling at whatever the pool now asks.
SLIPPAGE_BPS=1500

# Priority fee is 0 on purpose — this chain orders by arrival, not by price,
# so bidding gas up buys nothing. maxFee is only a spike guard.
MAX_FEE_GWEI=2
PRIORITY_FEE_GWEI=0
GAS_LIMIT=600000

# How hard to poll block.number while waiting for the launch block to clear.
POLL_MS=25

# false = actually broadcast. Leave true until you have watched it price a few
# real launches and agreed with what it wanted to do.
DRY_RUN=true

# ─────────────────────────────────────────────────────────────────────────────
# CURVE SNIPER (curve.js) — the bonding-curve venue, separate from the factory
# sniper above. This is the one with the measured edge.
# ─────────────────────────────────────────────────────────────────────────────

# Transport. Websocket detection is push-based and removes a whole round trip;
# without it every detection costs one RTT and on a 100ms chain that is blocks.
# Set BOTH — WS_URL detects, RPC_URL broadcasts.
WS_URL=wss://robinhood-rpc.publicnode.com
RPC_URL=https://robinhood-rpc.publicnode.com

# Ticket. 0.07-0.09 is the only band both measurements agree on. Do NOT shrink
# it to fit more slots: one operator at 0.066 made +2.0 ETH while its twin at
# 0.0297 was negative.
CURVE_BUY_ETH=0.08

# Reject anything that would land later than this many blocks after creation.
# Measured expectancy past ~6 blocks is negative, so skipping is correct.
CURVE_MAX_ENTRY_BLOCKS=6

# Floor on tokens received, bps off the modelled output. 10000 = no floor.
# The model is currently unreliable: true output for 0.02 ETH measured between
# 6.25M and 75M tokens on curves reporting identical config, against a model
# that always says 11.42M. A floor from that is arbitrary, and every live buy
# reverted at both 1200 and 3500. Protection comes from CURVE_MAX_ENTRY_BLOCKS
# (being early) plus the stop-loss, until the model is fixed.
CURVE_SLIPPAGE_BPS=10000

# Exit. Holding is where returns go: 10s +26.0%, first-other-sell +34.5%,
# hold-to-end -2.0%.
CURVE_HOLD_MS=30000
CURVE_TP_BPS=3000
CURVE_SL_BPS=3500

# Hard caps. 69.6% of wallets on this venue lose money; these stop a bad run
# instead of letting it compound.
CURVE_MAX_CONCURRENT=1
CURVE_MAX_DAILY_ETH=2
CURVE_MAX_LOSS_STREAK=8
